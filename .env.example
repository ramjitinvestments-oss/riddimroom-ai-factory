# Copy this file to .env and fill in real values. Never commit .env.

# --- Shopify ---
# SHOPIFY_STORE_DOMAIN is the full myshopify domain, e.g. your-store.myshopify.com
SHOPIFY_STORE_DOMAIN=
# Client ID/secret for a Dev Dashboard app, used with Shopify's OAuth client
# credentials grant. Replaces the retired admin-created custom app static
# token (SHOPIFY_ADMIN_API_ACCESS_TOKEN) — see
# https://shopify.dev/docs/apps/build/authentication-authorization/access-tokens/client-credentials-grant
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=
SHOPIFY_MAX_RETRIES=
SHOPIFY_RETRY_BASE_DELAY_MS=

# --- Printify ---
PRINTIFY_API_KEY=
PRINTIFY_SHOP_ID=
# Required to go live: pick a product (blueprint), print provider, and variants
# in your Printify account first (Printify's catalog API can list these), then
# fill in the real ids below. There is no safe default — these are account-
# and catalog-specific, so nothing is hardcoded/guessed for you.
PRINTIFY_BLUEPRINT_ID=
PRINTIFY_PRINT_PROVIDER_ID=
PRINTIFY_VARIANT_IDS=
PRINTIFY_MAX_RETRIES=
PRINTIFY_RETRY_BASE_DELAY_MS=
# Optional front-print placement overrides (fractions of the print area:
# x/y = center of the image, scale = image width). Leave unset to use the
# upper-chest standard baked into automation/printify/printify-provider.ts's
# defaults (x=0.5, y=0.35, scale=0.85) — see that file's doc comment for
# where those numbers came from and why they're an estimate, not a measured
# value, until verified against a real generated mockup.
PRINTIFY_PRINT_X=
PRINTIFY_PRINT_Y=
PRINTIFY_PRINT_SCALE=

# --- OpenAI ---
# Used for product copy generation (and, optionally, the Stage 2 AI vision
# quality judge). Artwork is no longer AI-generated — see the Asset Library.
OPENAI_API_KEY=
# Optional overrides for automation/ai's OpenAI product-copy provider:
OPENAI_PRODUCT_COPY_MODEL=
AI_PRODUCT_COPY_MAX_RETRIES=
AI_PRODUCT_COPY_RETRY_BASE_DELAY_MS=
# Optional overrides for automation/ai's OpenAI artwork-analysis provider
# (scripts/import-artwork.ts — classifies + writes copy from supplied artwork only):
OPENAI_ARTWORK_ANALYSIS_MODEL=
AI_ARTWORK_ANALYSIS_MAX_RETRIES=
AI_ARTWORK_ANALYSIS_RETRY_BASE_DELAY_MS=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- Google AI (Gemini) ---
GOOGLE_AI_API_KEY=

# --- Social Platforms ---
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
PINTEREST_ACCESS_TOKEN=
X_API_KEY=
X_API_SECRET=

# --- Pricing ---
# Fixed retail price (USD) applied to every shirt product, overriding any
# AI-suggested price or collection pricing band. Does not affect future
# non-shirt categories (hoodies, mugs, hats, etc.). Defaults to 24.99 if unset.
DEFAULT_SHIRT_PRICE=24.99

# --- General ---
LOG_LEVEL=info
NODE_ENV=development
# When true (the default), every external-service provider (AI, Printify, Shopify)
# runs in dry-run mode: no real network calls, realistic mock responses instead.
# Set to false only once real credentials above are filled in.
DRY_RUN=true
