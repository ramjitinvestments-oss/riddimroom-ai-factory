# Copy this file to .env and fill in real values. Never commit .env.

# --- Shopify ---
# SHOPIFY_STORE_DOMAIN is the full myshopify domain, e.g. your-store.myshopify.com
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_API_ACCESS_TOKEN=
SHOPIFY_API_VERSION=
SHOPIFY_MAX_RETRIES=
SHOPIFY_RETRY_BASE_DELAY_MS=

# --- Printify ---
PRINTIFY_API_KEY=
PRINTIFY_SHOP_ID=
# Required to go live: pick a product (blueprint), print provider, and variants
# in your Printify account first (Printify's catalog API can list these), then
# fill in the real ids below. There is no safe default — these are account-
# and catalog-specific, so nothing is hardcoded/guessed for you.
PRINTIFY_BLUEPRINT_ID=
PRINTIFY_PRINT_PROVIDER_ID=
PRINTIFY_VARIANT_IDS=
PRINTIFY_MAX_RETRIES=
PRINTIFY_RETRY_BASE_DELAY_MS=

# --- OpenAI ---
OPENAI_API_KEY=
# Optional overrides for automation/ai's OpenAI image provider (sensible defaults apply if unset):
OPENAI_IMAGE_MODEL=
AI_IMAGE_MAX_RETRIES=
AI_IMAGE_RETRY_BASE_DELAY_MS=
# Optional overrides for automation/ai's OpenAI product-copy provider:
OPENAI_PRODUCT_COPY_MODEL=
AI_PRODUCT_COPY_MAX_RETRIES=
AI_PRODUCT_COPY_RETRY_BASE_DELAY_MS=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- Google AI (Gemini) ---
GOOGLE_AI_API_KEY=

# --- Social Platforms ---
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
PINTEREST_ACCESS_TOKEN=
X_API_KEY=
X_API_SECRET=

# --- General ---
LOG_LEVEL=info
NODE_ENV=development
# When true (the default), every external-service provider (AI, Printify, Shopify)
# runs in dry-run mode: no real network calls, realistic mock responses instead.
# Set to false only once real credentials above are filled in.
DRY_RUN=true
